# Cloudflare Pages redirects file. One rule per line:
#   <source> <destination> <status>
# Static-export Next.js + CF Pages reads this at the edge before
# any page request hits the built HTML.

# Pricing lives inside the app (Clerk-authed). Marketing redirects
# to the public pricing page on the app subdomain so the ToS link
# (theobeliskstudio.com/pricing) resolves cleanly instead of 404ing.
/pricing https://us.graceproductionos.com/pricing 301
/pricing/ https://us.graceproductionos.com/pricing 301

# The closed-beta interest form is RETIRED — the open free beta replaced
# it with direct public sign-up. 301 the old form URL to the app sign-up
# page so any still-indexed link resolves cleanly.
/beta-interest https://us.graceproductionos.com/sign-up 301
/beta-interest/ https://us.graceproductionos.com/sign-up 301

# Grace legal pages are RETIRED on this domain. The canonical, maintained
# set now lives on graceproductionos.com (the app's LEGAL_HOST). These
# 301s stop the stale Obelisk-hosted copies from being served and send all
# traffic to the single source of truth. /privacy/request (the privacy
# intake form) intentionally STAYS on this domain, so these are exact-path
# rules and do not match /privacy/request.
/terms https://graceproductionos.com/terms 301
/terms/ https://graceproductionos.com/terms 301
/privacy https://graceproductionos.com/privacy 301
/privacy/ https://graceproductionos.com/privacy 301
/refunds https://graceproductionos.com/refunds 301
/refunds/ https://graceproductionos.com/refunds 301
/dmca https://graceproductionos.com/dmca 301
/dmca/ https://graceproductionos.com/dmca 301
/legal/vault https://graceproductionos.com/legal/vault 301
/legal/vault/ https://graceproductionos.com/legal/vault 301
/legal/dpa https://graceproductionos.com/legal/dpa 301
/legal/dpa/ https://graceproductionos.com/legal/dpa 301
/legal/subprocessors https://graceproductionos.com/legal/subprocessors 301
/legal/subprocessors/ https://graceproductionos.com/legal/subprocessors 301
